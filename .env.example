# ==========================================================================
#  CYBOK CONFIGURATION
#  Copy this file to ".env" (run.py does it automatically on first start).
#  Never share your .env file - it contains secret keys.
# ==========================================================================

# Secret used to sign sessions. Leave empty: run.py generates a strong one for you.
SECRET_KEY=

# --------------------------------------------------------------------------
#  AI MODELS - every option is FREE. You only need ONE of them:
#    * Ollama on this computer ("Cybok Local") - no key, offline, unlimited
#    * a free Groq key (no credit card)       - fastest and smartest
#  Keys can also be pasted inside Cybok: Admin > System > Free AI keys.
# --------------------------------------------------------------------------
# Groq - free tier, very fast open models (Cybok Fast / Smart / GPT-OSS / Llama 4 Vision)
#   Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - free open-weight models (models ending in ":free")
#   Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pollinations.ai - images work without it; a free token gives higher limits and a
#   more reliable "Cybok Open" text model.   https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# Hugging Face - FREE token, strongly recommended. Powers FLUX.1 Krea images and Wan2.1 video.
#   Without it, Hugging Face gives anonymous visitors very little free GPU time.
#   https://huggingface.co/settings/tokens  (tick "Make calls to Inference Providers")
HF_TOKEN=

# Local models: install Ollama (https://ollama.com), run "ollama pull llama3.2".
# The "Local Model (Ollama)" entry then works with no key and no internet.

# --------------------------------------------------------------------------
#  CYBOK IDENTITY
# --------------------------------------------------------------------------
# Official creation/launch date (YYYY-MM-DD). Used only the first time the
# database is created - afterwards change it in Admin > System.
# Leave empty if it hasn't been decided: Cybok will say it isn't configured.
CYBOK_CREATION_DATE=

# E-mails that automatically become administrators (comma separated).
# Note: the very first account created on a new installation is also made admin.
ADMIN_EMAILS=

# --------------------------------------------------------------------------
#  GOOGLE SIGN-IN (optional)
#  Create an OAuth client (type "Web application") at
#  https://console.cloud.google.com/apis/credentials
#  (Google sign-in is not used by the Streamlit version.)
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------------------
#  E-MAIL (optional) - for password-reset and security e-mails.
#  Without it, reset links are printed in the server console window.
#  Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, use an App Password.
# --------------------------------------------------------------------------
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true

# --------------------------------------------------------------------------
#  SERVER
# --------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
# Public address when deployed online (used in e-mails and Google sign-in), e.g. https://cybok.example.com
PUBLIC_URL=
# Set to true when running behind HTTPS (Nginx, Cloudflare, Render, Railway...)
SESSION_COOKIE_SECURE=false
BEHIND_PROXY=false
# Database: SQLite by default. For PostgreSQL: postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=
MAX_UPLOAD_MB=20

# Rate limits (requests per minute per user)
RATE_CHAT_PER_MIN=30
RATE_IMAGE_PER_MIN=8
RATE_UPLOAD_PER_MIN=20
RATE_AUTH_PER_5MIN=15
AI_TIMEOUT=120
